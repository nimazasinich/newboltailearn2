{
  "endpoints": {
    "health": {
      "GET /health": {
        "description": "Basic health check",
        "response": "{\"ok\": true, \"ts\": number}"
      },
      "GET /healthz": {
        "description": "Kubernetes health check",
        "response": "{\"ok\": true, \"ts\": number}"
      },
      "GET /readyz": {
        "description": "Kubernetes readiness check",
        "response": "{\"ok\": true, \"ts\": number}"
      },
      "GET /api/health": {
        "description": "API health check",
        "response": "{\"status\": \"ok\", \"timestamp\": string}"
      },
      "GET /api/health/enterprise": {
        "description": "Enterprise health check",
        "response": "{\"status\": \"ok\", \"enterprise\": true}"
      }
    },
    "auth": {
      "POST /api/auth/login": {
        "description": "User login",
        "payload": "{\"email\": string, \"password\": string}",
        "response": "{\"token\": string, \"user\": object}"
      },
      "POST /api/auth/register": {
        "description": "User registration",
        "payload": "{\"email\": string, \"password\": string, \"name\": string}",
        "response": "{\"token\": string, \"user\": object}"
      },
      "GET /api/auth/me": {
        "description": "Get current user",
        "auth": "required",
        "response": "{\"user\": object}"
      },
      "PUT /api/auth/profile": {
        "description": "Update user profile",
        "auth": "required",
        "payload": "{\"name\": string, \"email\": string}",
        "response": "{\"user\": object}"
      },
      "POST /api/auth/change-password": {
        "description": "Change password",
        "auth": "required",
        "payload": "{\"currentPassword\": string, \"newPassword\": string}",
        "response": "{\"success\": boolean}"
      }
    },
    "models": {
      "GET /api/models": {
        "description": "List all models",
        "response": "[{\"id\": string, \"name\": string, \"status\": string}]"
      },
      "POST /api/models": {
        "description": "Create new model",
        "payload": "{\"name\": string, \"type\": string, \"config\": object}",
        "response": "{\"id\": string, \"model\": object}"
      },
      "GET /api/models/:id": {
        "description": "Get model details",
        "response": "{\"id\": string, \"name\": string, \"status\": string, \"config\": object}"
      },
      "PUT /api/models/:id": {
        "description": "Update model",
        "payload": "{\"name\": string, \"config\": object}",
        "response": "{\"model\": object}"
      },
      "DELETE /api/models/:id": {
        "description": "Delete model",
        "response": "{\"success\": boolean}"
      },
      "POST /api/models/:id/train": {
        "description": "Start model training",
        "auth": "required",
        "role": "trainer",
        "payload": "{\"datasetId\": string, \"config\": object}",
        "response": "{\"sessionId\": string, \"status\": string}"
      },
      "POST /api/models/:id/pause": {
        "description": "Pause model training",
        "auth": "required",
        "role": "trainer",
        "response": "{\"success\": boolean}"
      },
      "POST /api/models/:id/resume": {
        "description": "Resume model training",
        "auth": "required",
        "role": "trainer",
        "response": "{\"success\": boolean}"
      },
      "POST /api/models/:id/optimize": {
        "description": "Start model optimization",
        "payload": "{\"config\": object}",
        "response": "{\"optimizationId\": string, \"status\": string}"
      },
      "POST /api/models/:id/export": {
        "description": "Export model",
        "auth": "required",
        "role": "trainer",
        "response": "{\"exportId\": string, \"downloadUrl\": string}"
      },
      "POST /api/models/:id/load": {
        "description": "Load model",
        "auth": "required",
        "role": "trainer",
        "response": "{\"success\": boolean, \"modelPath\": string}"
      },
      "GET /api/models/:id/checkpoints": {
        "description": "Get model checkpoints",
        "response": "[{\"id\": string, \"timestamp\": string, \"accuracy\": number}]"
      },
      "GET /api/models/:id/download/:filename": {
        "description": "Download model file",
        "response": "file stream"
      },
      "GET /api/models/stats/overview": {
        "description": "Get models overview stats",
        "auth": "required",
        "response": "{\"total\": number, \"active\": number, \"training\": number}"
      }
    },
    "datasets": {
